import streamlit as st
import pandas as pd

st.set_page_config(page_title="Sistema Open Bar", layout="wide")

st.title("🍹 Gestor de Open Bar - Módulo Fichas Técnicas")

# Inicializa o estoque se ele não existir
if 'ingredientes' not in st.session_state:
    st.session_state.ingredientes = pd.DataFrame({
        'Ingrediente': ['Rum', 'Suco Limão', 'Xarope', 'Gelo', 'Água com Gás', 'Hortelã'],
        'Preço_Total': [120.0, 5.0, 10.0, 2.0, 4.0, 5.0],
        'Rendimento_Total': [1000, 1000, 1000, 5000, 1000, 100],
        'Unidade': ['ml', 'ml', 'ml', 'gr', 'ml', 'folhas']
    })

# Aba de Estoque
st.header("1. Cadastro de Insumos")
st.write("Edite os preços e quantidades dos seus insumos:")
st.session_state.ingredientes = st.data_editor(st.session_state.ingredientes)

# Aba de Drink
st.header("2. Ficha Técnica do Drink")
nome_drink = st.text_input("Nome do Drink (ex: Mojito)")

if nome_drink:
    st.write(f"Custo estimado do {nome_drink}: ...")

st.success("Sistema rodando!")
